# 环境变量模板：复制为 .env 后填写；真实文件不提交，不要直接运行本模板。
# Python不自动读.env，使用 uv run --env-file .env 或PyCharm显式加载。
# MySQL连接串；凭证中的URL特殊字符需编码，真实值只填本机。
ODMFLOW_DATABASE_URL="请填写你的 MySQL URL，格式为 mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE"
# 部署模式；local用于回环地址开发，不代表已具备公网安全部署条件。
ODMFLOW_MODE="local"
# 允许的前端Origin；默认对应Vite 5173，须与浏览器地址完全一致，不混用localhost。
ODMFLOW_APP_ORIGIN="http://127.0.0.1:5173"
# 模型名须支持结构化任务规划/工具协议；未填写时Agent禁用，身份与health仍可运行。
ODMFLOW_LLM_MODEL="请输入支持工具调用的模型名"
# 模型API Key只填本地.env，不放TOML/前端/日志或Git。
ODMFLOW_LLM_API_KEY="请输入你的模型 API Key（只填本地 .env）"
# 服务商API地址，远端只允许HTTPS，本地回环HTTP可调试。
ODMFLOW_LLM_BASE_URL="https://请输入服务商的 API Base URL/v1"
# 可选RAG资源根绝对路径；rag.enabled=false时无需准备，启用前准备models和索引。
ODMFLOW_RAG_ROOT="请输入已准备模型的 RAG 资源根绝对路径"
# 部署级调试暴露开关，默认关闭；开启仍只显示本人记录。
ODMFLOW_TRACE_DEBUG_ENABLED="false"
# 实际应用配置位置：源码相对项目根，非源码部署填绝对路径，不指向.example。
ODMFLOW_CONFIG_FILE="application.toml"
